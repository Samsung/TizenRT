# Include the common ARMv7-R and ARM common source lists (NuttX 12.13.0 layout)

include armv7-r/Make.defs

# The chip provides its own vector table (overrides the armv7-r default)

HEAD_ASRC  = bcm4390x_vectortab.S

# Compatibility shims for the prebuilt chip library

CHIP_CSRCS += bcm4390x_shim.c

CFLAGS += -DPLATFORM_L1_CACHE_SHIFT=5
CFLAGS += -I$(TOPDIR)/../external/WICED/bcm4390x/include
CFLAGS += -I$(TOPDIR)/arch/$(CONFIG_ARCH)/include/$(CONFIG_ARCH_CHIP)/

# Chip support is provided as a prebuilt library

EXTRA_LIBS += chip/libbcmarch.a

# External WICED Lib builds

ifeq ($(CONFIG_WL_BCM4390X),y)
EXTRA_LIBS += $(EXTDIR)/WICED/libbcmexternal.a
endif
