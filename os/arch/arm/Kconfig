	string
	default "qemu"		if ARCH_CHIP_QEMU_ARM
	default "mps"		if ARCH_CHIP_MPS
	default "s5j"		if ARCH_CHIP_S5J
	default "tiva"      if ARCH_CHIP_LM
	default "bcm4390x"	if ARCH_CHIP_BCM4390X
