# Based on boards/arm/qemu/qemu-armv7a/scripts/Make.defs of NuttX 12.13.0.
# The compiler settings come from arch/arm/src/armv7-a/Toolchain.defs; the
# TizenRT specific parts are the location of the linker script, the
# framework and external include directories and the link map.

include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/arch/arm/src/armv7-a/Toolchain.defs

PREPROCESS_LDSCRIPT = y
LDSCRIPT = dramboot.ld
ARCHSCRIPT += $(TOPDIR)$(DELIM)..$(DELIM)build$(DELIM)configs$(DELIM)$(CONFIG_ARCH_BOARD)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

# TizenRT framework and external headers

ARCHINCLUDES += ${INCSYSDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)framework$(DELIM)include
ARCHINCLUDES += ${INCSYSDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)external$(DELIM)include
ARCHXXINCLUDES += ${INCSYSDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)framework$(DELIM)include
ARCHXXINCLUDES += ${INCSYSDIR_PREFIX}$(TOPDIR)$(DELIM)..$(DELIM)external$(DELIM)include

# EXTRADEFINES is used by the TizenRT build system to pass __KERNEL__ to the
# kernel libraries (EXTRAFLAGS in NuttX).

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) $(EXTRADEFINES)
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) $(EXTRADEFINES)
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) $(EXTRADEFINES)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

LDFLAGS += -Map=$(TOPDIR)$(DELIM)..$(DELIM)build$(DELIM)output$(DELIM)bin$(DELIM)tinyara.map

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)$(DELIM)binfmt$(DELIM)libnxflat$(DELIM)gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048
